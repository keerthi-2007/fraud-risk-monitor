}

stream -> main; stream -> feedback; client -> status; client -> retrainapi; feedback -> fbst; approver -> fbst; fbst -> train; cycle -> train; train -> evaluation; evaluation -> promotion; promotion -> deploy [style=dashed,label="explicit opt-in"]; deploy -> mlf [style=dashed,label="verified active model"]; train -> snapshot; retrainapi -> snapshot; status -> snapshot; main -> mlf; main -> metrics;
}
