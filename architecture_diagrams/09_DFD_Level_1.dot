digraph G {
 graph [rankdir=LR, splines=polyline, bgcolor="white", labelloc=t, fontname="DejaVu Sans", fontsize=23, fontcolor="#17243D", pad="0.38", nodesep="0.37", ranksep="0.83", outputorder=edgesfirst];
 node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=13, fontcolor="#18263D", color="#9AAAC0", fillcolor="#F5F8FC", penwidth=1.5, margin="0.18,0.13"];
 edge [fontname="DejaVu Sans", fontsize=10, color="#60738F", fontcolor="#475569", arrowsize=0.72, penwidth=1.5];
label="Data Flow Diagram | Level 1 with Candidate Retraining";
subgraph cluster_user { label="EXTERNAL ACTOR"; fontsize=16; fontname="DejaVu Sans"; fontcolor="#364559"; color="#A1C2EF"; style="rounded,dashed"; penwidth=1.2; margin=16;
user [label="Investigator / Reviewer", fillcolor="#EAF3FF", color="#6495D6"];
uploads [label="Transaction CSV / ZIP", fillcolor="#EAF3FF", color="#6495D6"];

}
subgraph cluster_inference { label="ONLINE PROCESSES"; fontsize=16; fontname="DejaVu Sans"; fontcolor="#364559"; color="#94CDAF"; style="rounded,dashed"; penwidth=1.2; margin=16;
intake [label="1. File intake
2. Validation", fillcolor="#E9F8F0", color="#50A47B"];
score [label="3. Approved model scoring", fillcolor="#E9F8F0", color="#50A47B"];
drift [label="4. PSI drift monitor", fillcolor="#E9F8F0", color="#50A47B"];
feedback [label="5. Feedback capture", fillcolor="#E9F8F0", color="#50A47B"];
pipeline [label="6. Pipeline status
7. Metrics export", fillcolor="#E9F8F0", color="#50A47B"];

}
subgraph cluster_candidate { label="OFFLINE PROCESSES"; fontsize=16; fontname="DejaVu Sans"; fontcolor="#364559"; color="#E8C490"; style="rounded,dashed"; penwidth=1.2; margin=16;
approval [label="8. Independent approval", fillcolor="#FFF2DE", color="#DC9B46"];
elig [label="9. Eligibility checks
20 total / 3 per class", fillcolor="#FFF2DE", color="#DC9B46"];
training [label="10. Candidate training
MLflow evaluation", fillcolor="#FFF2DE", color="#DC9B46"];
gate [label="11. Promotion checks
Default: NO deployment", fillcolor="#FFF0F0", color="#C7656C"];

}
subgraph cluster_store { label="DATA STORES"; fontsize=16; fontname="DejaVu Sans"; fontcolor="#364559"; color="#B7C4D5"; style="rounded,dashed"; penwidth=1.2; margin=16;
model [label="D1 Approved MLflow model", fillcolor="#F3F5F9", color="#98A6BB"];
baseline [label="D2 Training drift baseline", fillcolor="#F3F5F9", color="#98A6BB"];
labels [label="D3 Feedback + approvals", fillcolor="#F3F5F9", color="#98A6BB"];
snap [label="D4 DVC + retraining snapshots", fillcolor="#F3F5F9", color="#98A6BB"];

}

uploads -> intake -> score -> user; model -> score; intake -> drift; baseline -> drift; user -> feedback; feedback -> labels; labels -> approval -> elig -> training -> gate; training -> snap; model -> gate [style=dashed]; pipeline -> snap [dir=back]; pipeline -> user; elig -> snap; gate -> model [style=dashed,label="only explicit opt-in"];
}
